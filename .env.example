# Copy these values into your terminal environment. Never commit real credentials.
LINKEDIN_EMAIL=your-account-email
LINKEDIN_PASSWORD=your-account-password

# Explicit opt-in is required before any browser is started.
LINKEDIN_LIVE_TESTS=false

# Optional search phrase; default is "software testing".
LINKEDIN_SEARCH_TERM=software testing

# Optional. If unset, the test uses a fixed obviously-invalid value for one negative attempt.
# Do not set this to a real password.
LINKEDIN_INVALID_PASSWORD=
